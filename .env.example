# Copy to .env and fill in. Never commit .env.
# --- language models: azure (product) | github (free test) | ollama (local) ---
LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
MODEL_ANSWER=gpt-5.4
MODEL_JUDGE=gpt-5.4-mini
MODEL_ANSWER_FALLBACK=gpt-5.4-mini
EFFORT_ANSWER=low
EFFORT_JUDGE=low
# prices in USD per 1M tokens "input,output" from the Azure price sheet (for cost per question)
PRICE_ANSWER=
PRICE_JUDGE=
# --- embeddings: azure | ollama | none ---
EMBED_PROVIDER=azure
MODEL_EMBED=text-embedding-3-large
EMBED_DIM=1024
# --- free model test (fine-grained token with "Models: read") ---
GITHUB_MODELS_TOKEN=
# --- Azure AI Speech (audio reading, recitation) ---
SPEECH_KEY=
SPEECH_REGION=uaenorth
# --- local fallback ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b-it-qat
# --- limits and feature flags (1 = on) ---
PER_IP_PER_MINUTE=6
DAILY_QUESTION_CAP=2000
FEATURE_AUDIO=1
FEATURE_STUDY_TOOLS=1
FEATURE_RECITE=1
FEATURE_WORD=1
FEATURE_TAKHRIJ=1
FEATURE_SRS=1
FEATURE_NOTEBOOK=1
